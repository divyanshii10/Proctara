generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String             @db.VarChar(255)
  slug       String             @unique @db.VarChar(100)
  logoUrl    String?            @map("logo_url")
  plan       String             @default("free") @db.VarChar(20)
  settings   Json               @default("{}")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaigns  Campaign[]
  candidates Candidate[]
  users      CompanyUser[]
  sessions   InterviewSession[]
  jobRoles   JobRole[]
  questions  Question[]

  @@map("companies")
}

model CompanyUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  email        String   @db.VarChar(255)
  name         String?  @db.VarChar(255)
  role         String   @default("member") @db.VarChar(20)
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@map("company_users")
}

model Candidate {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String             @map("company_id") @db.Uuid
  campaignId   String?            @map("campaign_id") @db.Uuid
  email        String             @db.VarChar(255)
  name         String?            @db.VarChar(255)
  phone        String?            @db.VarChar(50)
  resumeUrl    String?            @map("resume_url")
  passwordHash String?            @map("password_hash")
  loginId      String?            @unique @map("login_id") @db.VarChar(100)
  expiresAt    DateTime?          @map("expires_at") @db.Timestamptz(6)
  metadata     Json               @default("{}")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign     Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions     InterviewSession[]

  @@unique([campaignId, email])
  @@map("candidates")
}

model Campaign {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  title       String             @db.VarChar(255)
  description String?
  jobRoleId   String             @map("job_role_id") @db.Uuid
  templateId  String             @map("template_id") @db.Uuid
  status      String             @default("active") @db.VarChar(20)
  durationMin Int                @default(45) @map("duration_min")
  expiresAt   DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  type        String             @default("AI_INTERVIEW") @db.VarChar(50)
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRole     JobRole            @relation(fields: [jobRoleId], references: [id])
  template    InterviewTemplate  @relation(fields: [templateId], references: [id])
  candidates  Candidate[]
  sessions    InterviewSession[]

  @@map("campaigns")
}

model JobRole {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  title       String              @db.VarChar(255)
  description String?
  skills      String[]            @default([])
  level       String?             @db.VarChar(20)
  status      String              @default("active") @db.VarChar(20)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  campaigns   Campaign[]
  sessions    InterviewSession[]
  templates   InterviewTemplate[]
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("job_roles")
}

model InterviewTemplate {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobRoleId   String             @map("job_role_id") @db.Uuid
  name        String             @db.VarChar(255)
  durationMin Int                @default(30) @map("duration_min")
  config      Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  campaigns   Campaign[]
  sessions    InterviewSession[]
  jobRole     JobRole            @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  questions   TemplateQuestion[]

  @@map("interview_templates")
}

model TemplateQuestion {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  questionId String            @map("question_id") @db.Uuid
  orderNum   Int               @map("order_num")
  question   Question          @relation(fields: [questionId], references: [id])
  template   InterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_questions")
}

model Question {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String?            @map("company_id") @db.Uuid
  type              String             @db.VarChar(20)
  difficulty        String?            @db.VarChar(10)
  topic             String?            @db.VarChar(100)
  content           String
  rubric            Json?
  testCases         Json?              @map("test_cases")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  codeSubmissions   CodeSubmission[]
  company           Company?           @relation(fields: [companyId], references: [id])
  responses         Response[]
  templateQuestions TemplateQuestion[]

  @@index([topic, difficulty])
  @@map("questions")
}

model InterviewSession {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId     String            @map("candidate_id") @db.Uuid
  jobRoleId       String            @map("job_role_id") @db.Uuid
  templateId      String            @map("template_id") @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  campaignId      String?           @map("campaign_id") @db.Uuid
  status          String            @default("pending") @db.VarChar(20)
  startedAt       DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)
  durationSec     Int?              @map("duration_sec")
  inviteToken     String            @unique @map("invite_token") @db.VarChar(64)
  trustScore      Decimal?          @map("trust_score") @db.Decimal(3, 2)
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  codeSubmissions CodeSubmission[]
  evaluation      Evaluation?
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id])
  jobRole         JobRole           @relation(fields: [jobRoleId], references: [id])
  template        InterviewTemplate @relation(fields: [templateId], references: [id])
  responses       Response[]

  @@index([companyId])
  @@index([candidateId])
  @@index([status])
  @@map("interview_sessions")
}

model Response {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  questionId     String?          @map("question_id") @db.Uuid
  questionText   String           @map("question_text")
  answerText     String?          @map("answer_text")
  answerAudioUrl String?          @map("answer_audio_url")
  sequenceNum    Int              @map("sequence_num")
  durationSec    Int?             @map("duration_sec")
  aiScore        Decimal?         @map("ai_score") @db.Decimal(5, 2)
  aiFeedback     Json?            @map("ai_feedback")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  question       Question?        @relation(fields: [questionId], references: [id])
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("responses")
}

model CodeSubmission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String           @map("session_id") @db.Uuid
  questionId      String?          @map("question_id") @db.Uuid
  language        String           @db.VarChar(20)
  sourceCode      String           @map("source_code")
  testResults     Json?            @map("test_results")
  executionTimeMs Int?             @map("execution_time_ms")
  memoryKb        Int?             @map("memory_kb")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  question        Question?        @relation(fields: [questionId], references: [id])
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("code_submissions")
}

model Evaluation {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String           @unique @map("session_id") @db.Uuid
  overallScore       Decimal          @map("overall_score") @db.Decimal(5, 2)
  recommendation     String?          @db.VarChar(20)
  scores             Json
  summary            String?
  strengths          String[]         @default([])
  weaknesses         String[]         @default([])
  reportUrl          String?          @map("report_url")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  transcriptAnalysis Json?            @map("transcript_analysis")
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([overallScore])
  @@map("evaluations")
}
